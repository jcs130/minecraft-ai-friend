# Keep manifest-verified patch bytes, including required blank context markers.
world/numen-patches/*.patch text eol=lf whitespace=-blank-at-eol

# Health check compares skill bytes against workspace copies deployed via text-mode API (LF).
world/ops/skills/** text eol=lf

# Preserve reviewed native function and patch hashes across Windows checkouts.
assets/town-renewal/** text eol=lf
assets/town-renewal/**/*.nbt binary
# Frozen one-time packs retain the exact bytes verified and deployed, including CRLF.
assets/town-renewal/operator-pack/** -text
assets/town-renewal/bridge-operator-pack/** -text whitespace=cr-at-eol
patches/guardvillagers/*.patch text eol=lf whitespace=-blank-at-eol
patches/decider/*.patch text eol=lf whitespace=-blank-at-eol

# Preserve the independently deployed Qiandengji harness source and npm lock hashes.
integrations/qiandengji-harness/*.mjs text eol=lf
integrations/qiandengji-harness/body-package*.json -text whitespace=cr-at-eol
tools/qiandengji_harness.py text eol=lf
tools/test_qiandengji_harness.py text eol=lf
skills/qiandengji-agent/** text eol=lf
tools/build_qiandengji_skill.py text eol=lf
tools/test_qiandengji_skill* text eol=lf
