#              函数在序列化源头统一剥离，三通道（entity/entityMoved/avatarState）全覆盖。
# 用法：docker build -f packaging/docker/Dockerfile.mc-world-modern -t mc-world:2.1.17 <repo 根>
FROM mc-world:2.1.16
COPY src/mc-modern-viewer.mts /app/src/mc-modern-viewer.mts
