+package com.dwinovo.numen.core.pathing.execute;
+
+import com.dwinovo.numen.core.pathing.bridge.ContextFactory;
+import com.dwinovo.numen.core.pathing.moves.CalculationContext;
+import com.dwinovo.numen.core.task.move.MoveToTaskRecord;
+import com.dwinovo.numen.entity.NumenPlayer;
+import com.dwinovo.numen.task.CompanionTickDispatcher;
+import com.dwinovo.numen.task.TaskRecord;
+import it.unimi.dsi.fastutil.longs.LongSet;
+import net.minecraft.world.entity.EquipmentSlot;
+import net.minecraft.world.item.enchantment.Enchantments;
+
+/** Task-local read-only navigation. No global settings or persistent player edits. */
+public final class WalkOnlyNavigation {
+    private WalkOnlyNavigation() {}
+    public static final String EPOCH = java.util.UUID.randomUUID().toString();
+    private static final java.util.LinkedHashMap<java.util.UUID, java.util.Map<String, Object>> RESULTS =
+            new java.util.LinkedHashMap<>();
+
+    /** Only final TaskSlot outcomes enter this bounded cache; idle is never inferred as success. */
+    public static synchronized void recordResult(java.util.UUID body, MoveToTaskRecord task,
+                                                 java.util.Map<String, Object> data, String reason) {
+        if (!task.getState().isTerminal()) return;
+        java.util.Map<String, Object> result = new java.util.HashMap<>(data);
+        result.put("task_id", task.publicId());
+        result.put("navigation_epoch", EPOCH);
+        result.put("state", task.getState().name().toLowerCase(java.util.Locale.ROOT));
+        result.put("success", task.getState() == com.dwinovo.numen.task.TaskState.SUCCESS);
+        result.put("reason", reason == null ? "" : reason.substring(0, Math.min(reason.length(), 400)));
+        result.put("finished_at", System.currentTimeMillis());
+        RESULTS.remove(body);
+        RESULTS.put(body, java.util.Map.copyOf(result));
+        while (RESULTS.size() > 32) RESULTS.remove(RESULTS.keySet().iterator().next());
+    }
+
+    public static synchronized java.util.Map<String, Object> lastResult(java.util.UUID body) {
+        return RESULTS.get(body);
+    }
+
+    public static final PlayerNav.ContextProvider CONTEXTS = new PlayerNav.ContextProvider() {
+        @Override public CalculationContext forSearch(NumenPlayer player, LongSet sacred, LongSet denied) {
+            return ContextFactory.forSearch(player, sacred, denied,
+                    (p, v, l, threaded, s, d) -> new CalculationContext(p, v, l, threaded, s, d, true));
+        }
+        @Override public CalculationContext forExecution(NumenPlayer player, LongSet sacred, LongSet denied) {
+            return ContextFactory.forExecution(player, sacred, denied,
+                    (p, v, l, threaded, s, d) -> new CalculationContext(p, v, l, threaded, s, d, true));
+        }
+    };
+
+    public static boolean blockInteraction(TaskRecord record, boolean clicked) {
+        if (clicked && record instanceof MoveToTaskRecord move && move.walkOnly) {
+            move.walkInteractionBlocked = true;
+            return true;
+        }
+        return false;
+    }
+
+    public static boolean isWalkOnly(TaskRecord record) {
+        return record instanceof MoveToTaskRecord move && move.walkOnly;
+    }
+
+    public static boolean isActive(NumenPlayer player) {
+        return isWalkOnly(CompanionTickDispatcher.currentTaskFor(player.getUUID()));
+    }
+
+    public static boolean blockInteraction(NumenPlayer player, boolean clicked) {
+        return clicked && blockInteraction(CompanionTickDispatcher.currentTaskFor(player.getUUID()), true);
+    }
+
+    /** Frost Walker changes world blocks even without a click. Keep the equipment; decline travel. */
+    public static boolean hasWorldChangingEquipment(NumenPlayer player) {
+        for (EquipmentSlot slot : EquipmentSlot.values()) {
+            var enchants = player.getItemBySlot(slot).getEnchantments();
+            for (var enchantment : enchants.keySet()) {
+                if (enchantment.is(Enchantments.FROST_WALKER) && enchants.getLevel(enchantment) > 0) return true;
+            }
+        }
+        return false;
+    }
+}
