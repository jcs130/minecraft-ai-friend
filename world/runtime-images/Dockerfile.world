FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ git pkg-config libcairo2-dev libpango1.0-dev \
    libjpeg-dev libgif-dev librsvg2-dev libxi-dev libxext-dev \
    libx11-dev libgl1-mesa-dev libosmesa6 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY world/package.json world/package-lock.json world/.npmrc ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
# Current source and the renderer's workers are explicit build inputs. Runtime
# mounts may update these files, but a clean image never relies on an old layer.
COPY world/src ./src
COPY world/admin ./admin
COPY world/bootstrap-world.mts ./bootstrap-world.mts
COPY vendor/modern-viewer ./modern-viewer
COPY world/runtime-images/smoke-world.cjs /opt/smoke-world.cjs
RUN node /opt/smoke-world.cjs
ENV NODE_ENV=production
CMD ["/app/node_modules/.bin/tsx", "/app/bootstrap-world.mts"]
