# QwenPaw 智能层宿主镜像（2026-08-21 造物主点名容器化）
#
# QwenPaw（包名 qwenpaw==2.1.0，旧称 CoPaw）是所有 agent 的宿主：
#   mc-god（女神）/ mc-guard-kirito / mc-guard-naruto / mc-herald / mc-hearth / default（小智）等。
# 启动命令 `qwenpaw app`，监听 8088，飞书为主要通道。
#
# build context = 本仓库根目录（仅借 Dockerfile，无源码依赖）
#   docker build -t mc-qwenpaw -f Dockerfile.qwenpaw .
#
# 数据目录（WORKING_DIR）：qwenpaw 优先级为 QWENPAW_WORKING_DIR env > ~/.copaw(legacy) > 默认 ~/.qwenpaw。
# 本容器是【全新安装】——无 legacy ~/.copaw 包袱，数据根 = ~/.qwenpaw（标准路径）。
# compose 把宿主机提炼数据（~/.qwenpaw-agentos）挂载到 /root/.qwenpaw；勿挂 /root/.copaw。
FROM python:3.12-slim

WORKDIR /app

# 系统库：飞书/HTTP 通道与 playwright 浏览器所需的最小集
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# 安装 QwenPaw 全家桶（agentscope + 多通道 + playwright + onnxruntime 等）
RUN pip install --no-cache-dir qwenpaw==2.1.0 \
  -i https://pypi.tuna.tsinghua.edu.cn/simple

EXPOSE 8088

# 全新安装默认数据根 ~/.qwenpaw；挂载点见 compose（/root/.qwenpaw）
CMD ["qwenpaw", "app"]
