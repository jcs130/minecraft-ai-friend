{
  "dataDir": "./private-minecraft-data",
  "timezone": "UTC",
  "acceptsImages": false,
  "metricsPort": 0,
  "consolePort": 7796,
  "world": {
    "server": "paper-survival",
    "servers": {
      "paper-survival": {
        "label": "Paper 1.21.11 public survival (AuthMe)",
        "host": "survival.example.test",
        "port": 25565,
        "version": "1.21.11",
        "username": "ag_example",
        "auth": "offline",
        "loginConfigFile": "./private-login-config.json",
        "publicDnsFallback": true,
        "connectAddresses": [],
        "dohResolvers": ["https://cloudflare-dns.com/dns-query", "https://dns.google/resolve"],
        "connectTimeoutMs": 8000,
        "maxReconnectAttempts": 12,
        "account": { "usernamePrefix": "ag_", "maxLength": 16 },
        "safety": {
          "publicChat": true,
          "chat": { "minIntervalMs": 4000, "perMinute": 6, "dedupMs": 120000, "maxChars": 120 },
          "commands": { "mode": "all", "block": ["pay", "sell", "ah", "trade", "kill", "suicide"], "minIntervalMs": 1500 },
          "privateMessages": true,
          "protectedCircles": [{ "name": "spawn", "x": 0, "z": 0, "r": 40 }],
          "structureGuard": { "enabled": true, "radius": 4, "relaxedWorlds": ["minecraft:resource"] },
          "stopOnWarning": true,
          "warningKeywords": ["请停止", "警告"]
        }
      },
      "modded-friends": {
        "label": "NeoForge 1.21.1 friends server (config only)",
        "host": "friends.example.test",
        "port": 25702,
        "version": "1.21.1",
        "username": "ag_example",
        "auth": "offline",
        "loginConfigFile": "./private-login-config.json",
        "account": { "usernamePrefix": "ag_", "maxLength": 16, "avoidNames": ["Admin", "Player"] },
        "safety": { "publicChat": true, "commands": { "mode": "allowlist", "allow": ["help", "list"] } }
      },
      "snapshot": {
        "label": "26.2 server",
        "host": "snapshot.example.test",
        "version": "26.2",
        "username": "ag_example",
        "auth": "offline",
        "selectable": false,
        "notes": "selectable:false keeps it listed and validated but refuses to start with it."
      }
    }
  }
}
