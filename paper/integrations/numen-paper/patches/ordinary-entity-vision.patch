+        if (self.level() != target.level() || target.isSpectator() || invisible) {
+            return HIDDEN;
+        }
+        Vec3 eye = self.getEyePosition();
+        BlockHitResult first = self.level().clip(new VisualRay(eye, target.getEyePosition(), self));
+        if (first.getType() == HitResult.Type.MISS) {
+            return VISIBLE;
+        }
+        AABB box = target.getBoundingBox();
+        double insetX = Math.min(0.01, box.getXsize() / 4);
+        double insetY = Math.min(0.01, box.getYsize() / 4);
+        double insetZ = Math.min(0.01, box.getZsize() / 4);
+        for (int y = 0; y < 3; y++) {
+            for (int x = 0; x < 3; x++) {
+                for (int z = 0; z < 3; z++) {
+                    Vec3 point = new Vec3(box.minX + insetX + (box.getXsize() - 2 * insetX) * x / 2,
+                            box.minY + insetY + (box.getYsize() - 2 * insetY) * y / 2,
+                            box.minZ + insetZ + (box.getZsize() - 2 * insetZ) * z / 2);
+                    if (self.level().clip(new VisualRay(eye, point, self)).getType() == HitResult.Type.MISS) {
+                        return VISIBLE;
+                    }
+                }
+            }
+        }
+        return new View(false, first.getBlockPos());
+    }
