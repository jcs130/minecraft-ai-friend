--- /dev/null
+++ b/numen/common/src/test/java/com/dwinovo/numen/scan/OcclusionBoxTest.java
@@ -0,0 +1,77 @@
+package com.dwinovo.numen.scan;
+
+import com.dwinovo.numen.pathing.Vanilla;
+import java.util.Random;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.Vec3;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class OcclusionBoxTest {
+    @BeforeAll static void boot() { Vanilla.boot(); }
+
+    @Test void blocksInAllSixAxisDirections() {
+        var box = new OcclusionBox(0, 0, 0, 1, 1, 1);
+        assertTrue(box.blocks(-2, .5, .5, 3, .5, .5));
+        assertTrue(box.blocks(3, .5, .5, -2, .5, .5));
+        assertTrue(box.blocks(.5, -2, .5, .5, 3, .5));
+        assertTrue(box.blocks(.5, 3, .5, .5, -2, .5));
+        assertTrue(box.blocks(.5, .5, -2, .5, .5, 3));
+        assertTrue(box.blocks(.5, .5, 3, .5, .5, -2));
+    }
+
+    @Test void delegatesOriginInsideAndBoundaryRaysToExactTracing() {
+        var box = new OcclusionBox(0, 0, 0, 1, 1, 1);
+        assertFalse(box.blocks(.5, .5, .5, 3, .5, .5));
+        assertFalse(box.blocks(-2, 0, .5, 3, 0, .5));
+        assertFalse(box.blocks(-2, 1, 1, 3, 1, 1));
+        assertFalse(box.blocks(-2, .5, .5, -2, .5, .5));
+    }
+
+    @Test void doesNotBlockBeforeTheRayReachesTheWall() {
+        var box = new OcclusionBox(0, 0, 0, 1, 1, 1);
+        assertFalse(box.blocks(-2, .5, .5, -.1, .5, .5));
+        assertFalse(box.blocks(-2, .5, .5, 0, .5, .5));
+        assertTrue(box.blocks(-2, .5, .5, .5, .5, .5));
+    }
+
+    @Test void tinyOrEmptyGeometryDoesNotBecomeAnExpandedWall() {
+        assertFalse(new OcclusionBox(0, 0, 0, 1E-9, 1, 1).blocks(-2, .5, .5, 3, .5, .5));
+        assertFalse(new OcclusionBox(0, 0, 0, 1, 0, 1).blocks(-2, 0, .5, 3, 0, .5));
+    }
+
+    @Test void mergesOnlySolidRectangularUnions() {
+        var b = new OcclusionBox(-1, -1, -1, 0, 0, 0);
+        assertEquals(new OcclusionBox(-1, -1, -1, 1, 0, 0), b.merge(new OcclusionBox(0, -1, -1, 1, 0, 0)));
+        assertEquals(new OcclusionBox(-1, -1, -1, 0, 1, 0), b.merge(new OcclusionBox(-1, 0, -1, 0, 1, 0)));
+        assertEquals(new OcclusionBox(-1, -1, -1, 0, 0, 1), b.merge(new OcclusionBox(-1, -1, 0, 0, 0, 1)));
+        assertNull(b.merge(new OcclusionBox(0, 0, -1, 1, 1, 0)), "L-shaped union must not fill its missing corner");
+        assertNull(b.merge(new OcclusionBox(1E-9, -1, -1, 1, 0, 0)), "tiny gaps remain gaps");
+    }
+
+    @Test void randomFastPositiveAlwaysHasAVanillaIntersection() {
+        Random random = new Random(0x71a14);
+        for (int i = 0; i < 20000; i++) {
+            double x = random.nextDouble() * 40 - 20, y = random.nextDouble() * 40 - 20,
+                    z = random.nextDouble() * 40 - 20;
+            var fast = new OcclusionBox(x, y, z, x + .25 + random.nextDouble() * 4,
+                    y + .25 + random.nextDouble() * 4, z + .25 + random.nextDouble() * 4);
+            var exact = new AABB(fast.minX(), fast.minY(), fast.minZ(), fast.maxX(), fast.maxY(), fast.maxZ());
+            Vec3 from = new Vec3(random.nextDouble() * 60 - 30, random.nextDouble() * 60 - 30, random.nextDouble() * 60 - 30);
+            Vec3 to = new Vec3(random.nextDouble() * 60 - 30, random.nextDouble() * 60 - 30, random.nextDouble() * 60 - 30);
+            if (fast.blocks(from.x, from.y, from.z, to.x, to.y, to.z))
+                assertTrue(exact.clip(from, to).isPresent(), "fast path invented an intersection");
+        }
+    }
+
+    @Test void convexShadowCoversTheInteriorWhenAllCornersAreBlocked() {
+        var box = new OcclusionBox(4, -3, -3, 5, 3, 3);
+        var exact = new AABB(4, -3, -3, 5, 3, 3);
+        Vec3 eye = new Vec3(0, 1.5, 0);
+        for (int side = 0; side < 8; side++)
+            assertTrue(box.blocks(eye.x, eye.y, eye.z, 8 + (side & 1), -1 + (side >> 1 & 1) * 3, -1 + (side >> 2 & 1) * 2));
+        for (int x = 0; x <= 8; x++) for (int y = 0; y <= 8; y++) for (int z = 0; z <= 8; z++)
+            assertTrue(exact.clip(eye, new Vec3(8 + x / 8.0, -1 + 3 * y / 8.0, -1 + 2 * z / 8.0)).isPresent());
+    }
+}
