+++ b/numen/common/src/main/java/com/dwinovo/numen/scan/OcclusionBox.java
@@ -0,0 +1,47 @@
+package com.dwinovo.numen.scan;
+
+/** 单个实心长方体的影锥是凸集:目标盒八角都在影内,盒内的身体采样点也一定被挡住。 */
+record OcclusionBox(double minX, double minY, double minZ, double maxX, double maxY, double maxZ) {
+    private static final double EPSILON = 1.0E-7;
+
+    /** 只合并接触或重叠且横截面相同的盒子,不把 L 形或有缝的墙补成实心。 */
+    OcclusionBox merge(OcclusionBox b) {
+        if (minY == b.minY && maxY == b.maxY && minZ == b.minZ && maxZ == b.maxZ
+                && minX <= b.maxX && b.minX <= maxX)
+            return new OcclusionBox(Math.min(minX, b.minX), minY, minZ, Math.max(maxX, b.maxX), maxY, maxZ);
+        if (minX == b.minX && maxX == b.maxX && minZ == b.minZ && maxZ == b.maxZ
+                && minY <= b.maxY && b.minY <= maxY)
+            return new OcclusionBox(minX, Math.min(minY, b.minY), minZ, maxX, Math.max(maxY, b.maxY), maxZ);
+        if (minX == b.minX && maxX == b.maxX && minY == b.minY && maxY == b.maxY
+                && minZ <= b.maxZ && b.minZ <= maxZ)
+            return new OcclusionBox(minX, minY, Math.min(minZ, b.minZ), maxX, maxY, Math.max(maxZ, b.maxZ));
+        return null;
+    }
+
+    /** 射线必须穿过盒内部;擦边、零长、观察者在遮挡内的情况留给原版精检。 */
+    boolean blocks(double x, double y, double z, double toX, double toY, double toZ) {
+        if (maxX - minX <= 2 * EPSILON || maxY - minY <= 2 * EPSILON || maxZ - minZ <= 2 * EPSILON) return false;
+        if (x >= minX && x <= maxX && y >= minY && y <= maxY && z >= minZ && z <= maxZ) return false;
+        double dx = toX - x, dy = toY - y, dz = toZ - z;
+        double near = 0, far = 1;
+        if (dx == 0) {
+            if (x <= minX + EPSILON || x >= maxX - EPSILON) return false;
+        } else {
+            double a = (minX + EPSILON - x) / dx, b = (maxX - EPSILON - x) / dx;
+            near = Math.max(near, Math.min(a, b)); far = Math.min(far, Math.max(a, b));
+        }
+        if (dy == 0) {
+            if (y <= minY + EPSILON || y >= maxY - EPSILON) return false;
+        } else {
+            double a = (minY + EPSILON - y) / dy, b = (maxY - EPSILON - y) / dy;
+            near = Math.max(near, Math.min(a, b)); far = Math.min(far, Math.max(a, b));
+        }
+        if (dz == 0) {
+            if (z <= minZ + EPSILON || z >= maxZ - EPSILON) return false;
+        } else {
+            double a = (minZ + EPSILON - z) / dz, b = (maxZ - EPSILON - z) / dz;
+            near = Math.max(near, Math.min(a, b)); far = Math.min(far, Math.max(a, b));
+        }
+        return far - near > EPSILON;
+    }
+}
