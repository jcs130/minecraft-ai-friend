+        }
+
+        @Override
+        public VoxelShape getBlockShape(BlockState state, BlockGetter level, BlockPos pos) {
+            // 栅栏的视觉/选择轮廓把横杆间的空气也包进去了,遮面形状才保留下面的开口。
+            if (state.getBlock() instanceof FenceBlock) {
+                return state.getOcclusionShape(level, pos);
+            }
+            return state.getBlock() instanceof HalfTransparentBlock || state.getBlock() instanceof LeavesBlock
+                    ? Shapes.empty() : super.getBlockShape(state, level, pos);
+        }
+
+        @Override
+        public VoxelShape getFluidShape(FluidState state, BlockGetter level, BlockPos pos) {
+            return state.is(FluidTags.LAVA) ? state.getShape(level, pos) : Shapes.empty();
+        }
+    }
