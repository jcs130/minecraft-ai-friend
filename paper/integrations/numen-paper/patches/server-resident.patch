+package com.dwinovo.numen.e2e;
+
+import org.junit.jupiter.api.Test;
+
+import static com.dwinovo.numen.e2e.FakeModel.lua;
+import static com.dwinovo.numen.e2e.FakeModel.say;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/** 真服务端、原版连接、本地假模型:主人离线后常驻者继续,同主人的普通同伴待命,命令不给普通玩家。 */
+class ResidentTest extends Scenario {
+    @Test
+    void an_admin_kick_is_reported_as_removal_and_does_not_restart_the_resident() throws Exception {
+        Bot owner = join("e2e_removal", "zh_cn");
+        summon(owner, "ResidentK");
+        console("numen resident enable ResidentK");
+        console("kick ResidentK resident-kick-proof");
+        Thread.sleep(1000);
+        String status = console("numen resident status ResidentK");
+        assertTrue(status.contains("body=false") && status.contains("bodyState=REMOVED"), status);
+        assertTrue(status.contains("resident-kick-proof"), status);
+        Thread.sleep(1500);
+        assertFalse(console("list").contains("ResidentK"), "被踢出后不能自行重入");
+    }
+
+    @Test
+    void residencyIsAdminOnlyAndStatusDoesNotChangeIt() throws Exception {
+        Bot owner = join("e2e_resident", "zh_cn");
+        summon(owner, "ResidentA");
+        String before = console("numen resident status ResidentA");
+        assertTrue(before.contains("enabled=false"), before);
+        owner.command("numen resident enable ResidentA");
+        Thread.sleep(250);
+        assertTrue(console("numen resident status ResidentA").contains("enabled=false"));
+        assertTrue(console("numen resident enable ResidentA").contains("enabled=true"));
+        assertTrue(console("numen resident enable ResidentA").contains("enabled=true"));
+        assertTrue(console("list").split("ResidentA", -1).length == 2, "重复开启不能造出第二具身体");
+        assertTrue(console("numen resident status ResidentA").contains("enabled=true"));
+        assertTrue(console("numen resident disable ResidentA").contains("enabled=false"));
+    }
+
+    @Test
+    void theResidentFinishesAProgramAndThinksAgainAfterOwnerLogout() throws Exception {
+        Bot owner = join("e2e_away", "zh_cn");
+        summon(owner, "ResidentB");
+        summon(owner, "OrdinaryB");
+        console("numen resident enable ResidentB");
+        // Lua 等待真实服务器时间,下一次请求只有程序完成、回执进了模型才会出现。
+        MODEL.whenHeard("resident-offline-proof", lua("numen.time.wait(4); return 'resident-task-finished'"),
+                say("resident-model-finished"));
+        MODEL.whenHeard("ordinary-offline-proof", say("ordinary-model-finished"));
+        owner.command("msg ResidentB resident-offline-proof");
+        long deadline = System.nanoTime() + WAIT.toNanos();
+        while (!MODEL.wasToldAbout("resident-offline-proof")) {
+            assertTrue(System.nanoTime() < deadline, "常驻请求没进模型");
+            Thread.sleep(50);
+        }
+        owner.close();
+        try {
+            deadline = System.nanoTime() + WAIT.toNanos();
+            while (MODEL.asked().stream().noneMatch(a -> a.lastToolCallId() != null
+                    && a.body().contains("resident-task-finished"))) {
+                assertTrue(System.nanoTime() < deadline, "离线后没有收到实际程序的完成回执");
+                Thread.sleep(100);
+            }
+            assertTrue(console("numen resident status ResidentB").contains("body=true"));
+            assertFalse(console("numen resident status ResidentB").contains("hold=AWAY"));
+            assertTrue(console("numen resident status OrdinaryB").contains("hold=AWAY"));
+            console("numen resident disable ResidentB");
+            assertTrue(console("numen resident status ResidentB").contains("hold=AWAY"));
+        } finally {
+            // Scenario 用主人命令遣散,收场前重新连回来,只用于关闭本用例的两具身体。
+            owner = join("e2e_away", "zh_cn");
+            owner.command("numen player despawn ResidentB");
+            owner.command("numen player despawn OrdinaryB");
+        }
+    }
+}
