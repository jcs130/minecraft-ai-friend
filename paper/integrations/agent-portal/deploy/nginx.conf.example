# qiandengji-agent-portal
server {
    listen 80;
    server_name mc.kangqiang.site;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }
    location / { return 308 https://mc.kangqiang.site$request_uri; }
}
server {
    listen 443 ssl http2;
    server_name mc.kangqiang.site;
    ssl_certificate /etc/qiandengji-portal/tls/fullchain.pem;
    ssl_certificate_key /etc/qiandengji-portal/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:qd_portal_tls:1m;
    ssl_session_timeout 1d;
    client_max_body_size 3m;
    access_log /var/log/nginx/qiandengji-portal.access.log;
    error_log /var/log/nginx/qiandengji-portal.error.log;
    location / {
        proxy_pass http://127.0.0.1:8790;
        proxy_http_version 1.1;
        proxy_set_header Host mc.kangqiang.site;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_read_timeout 25s;
        proxy_send_timeout 25s;
    }
}
