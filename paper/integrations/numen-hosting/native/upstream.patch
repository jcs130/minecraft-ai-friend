+package com.dwinovo.numen.api.entity;
+
+import com.dwinovo.numen.api.store.Atomic;
+import com.google.gson.*;
+import java.nio.file.*;
+import java.nio.channels.FileChannel;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.function.Supplier;
+
+/** A per-server action journal. Disk work never runs on the game thread. An
+ * acknowledged reservation is durable before the body may act. A pending file
+ * from a previous process is UNKNOWN, not permission to replay the action. */
+public final class HostedActionReceipts implements AutoCloseable {
+    private final Path root;
+    private final ExecutorService io=Executors.newSingleThreadExecutor(r->{var t=new Thread(r,"numen-hosted-receipts");t.setDaemon(true);return t;});
+    private final Map<String,CompletableFuture<JsonObject>> active=new HashMap<>();
+    /** 扫描旧回执只在每具身体首次访问时做，常驻运行不能每个动作重读全部历史。 */
+    private final Map<UUID,Set<String>> unresolved=new HashMap<>();
+    public HostedActionReceipts(Path root) { this.root=root; }
+    private static String digest(String text) {
+        try { return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(text.getBytes(StandardCharsets.UTF_8))); }
+        catch(java.security.NoSuchAlgorithmException e){throw new IllegalStateException(e);}
+    }
+    private static JsonElement canonical(JsonElement value) {
+        if(value.isJsonObject()){var out=new JsonObject();new TreeMap<>(value.getAsJsonObject().asMap()).forEach((k,v)->out.add(k,canonical(v)));return out;}
+        if(value.isJsonArray()){var out=new JsonArray();value.getAsJsonArray().forEach(v->out.add(canonical(v)));return out;}
+        return value;
+    }
+    private Path path(UUID body,String id) {
+        if(id==null||!id.matches("[A-Za-z0-9_.:-]{8,120}"))throw new IllegalArgumentException("action ID must be 8-120 safe characters");
+        return root.resolve(body.toString()).resolve(digest(id)+".json");
+    }
+    private JsonObject read(Path file)throws java.io.IOException {return JsonParser.parseString(Files.readString(file)).getAsJsonObject();}
+    private void write(Path file,JsonObject value)throws java.io.IOException {
+        Atomic.write(file,value.toString());
+        try(var channel=FileChannel.open(file,StandardOpenOption.WRITE)){channel.force(true);}
+    }
+    private static JsonObject receipt(String id,String state,String message) {
+        var value=new JsonObject();value.addProperty("id",id);value.addProperty("state",state);value.addProperty("message",message);return value;
+    }
+    private JsonObject persistedResult(JsonObject saved){
+        if(saved.get("state").getAsString().equals("pending"))return receipt(saved.get("id").getAsString(),"unknown","Original action has no final receipt. Inspect the body; do not replay it.");
+        return saved.getAsJsonObject("receipt").deepCopy();
+    }
+    private Set<String> unresolved(UUID body,Path directory)throws java.io.IOException {
+        var known=unresolved.get(body);if(known!=null)return known;
+        var pending=new HashSet<String>();
+        if(Files.isDirectory(directory))try(var files=Files.list(directory)){
+            for(Path file:files.filter(p->p.toString().endsWith(".json")).toList()){
+                var saved=read(file);String state=saved.get("state").getAsString();
+                if(state.equals("pending")||state.equals("unknown"))pending.add(saved.get("id").getAsString());
+            }
+        }
+        unresolved.put(body,pending);return pending;
+    }
+    public CompletableFuture<JsonObject> call(UUID body,String id,JsonObject args,Supplier<CompletableFuture<JsonObject>> action){
+        var result=new CompletableFuture<JsonObject>();
+        io.execute(()->{
+            try{
+                Path file=path(body,id);String key=file.toString(),signature=digest(canonical(args).toString());
+                if(Files.exists(file)){
+                    var saved=read(file);
+                    if(!signature.equals(saved.get("signature").getAsString()))throw new IllegalStateException("request ID was already used with different arguments");
+                    var running=active.get(key);
+                    if(running!=null)running.whenComplete((r,e)->{if(e!=null)result.completeExceptionally(e);else result.complete(r.deepCopy());});
+                    else result.complete(persistedResult(saved));
+                    return;
+                }
+                var pending=unresolved(body,file.getParent());
+                if(!pending.isEmpty())throw new IllegalStateException("an earlier action is unresolved; query its original receipt");
+                var saved=new JsonObject();saved.addProperty("id",id);saved.addProperty("state","pending");saved.addProperty("signature",signature);
+                write(file,saved);pending.add(id);active.put(key,result);
+                CompletableFuture<JsonObject> execution;
+                try{execution=action.get();}catch(Throwable error){execution=CompletableFuture.failedFuture(error);}
+                execution.whenComplete((value,error)->{
+                  try{io.execute(()->{
+                    try{
+                        var finalValue=error==null?value:receipt(id,"unknown","Execution outcome is unknown; do not replay the original action.");
+                        if(!id.equals(finalValue.get("id").getAsString()))throw new IllegalStateException("receipt ID mismatch");
+                        saved.addProperty("state",finalValue.get("state").getAsString());saved.add("receipt",finalValue.deepCopy());
+                        write(file,saved);
+                        if(!Set.of("pending","unknown").contains(finalValue.get("state").getAsString()))pending.remove(id);
+                        result.complete(finalValue);
+                    }catch(Throwable failure){result.completeExceptionally(failure);}finally{active.remove(key);}
+                  });}catch(RejectedExecutionException stopping){result.completeExceptionally(stopping);}
+                });
+            }catch(Throwable error){result.completeExceptionally(error);}
+        });return result;
+    }
+    public CompletableFuture<JsonObject> result(UUID body,String id){return CompletableFuture.supplyAsync(()->{
+        try{return persistedResult(read(path(body,id)));}catch(java.io.IOException e){throw new CompletionException(e);}
+    },io);}
+    @Override public void close(){io.shutdown();}
+}
