+/** Main-thread observation for a fenced, idle body. No input, chunk tickets or inbox reads. */
+final class HostedBattlefield {
+    private static final int MAX_THREATS = 6;
+    private static final int MAX_SIGHT_CHECKS = 24;
+
+    private HostedBattlefield() {}
+
+    static boolean workPending(NumenPlayer body) {
+        var id = body.getUUID();
+        return ServerPrograms.running(id) || !CompanionTickDispatcher.hostingIdle(id);
+    }
+
+    static JsonElement sample(NumenPlayer body) {
+        if (!body.isAlive() || body.isSpectator() || body.isCreative() || body.isSleeping()
+                || body.isPassenger() || workPending(body)
+                || !CompanionLoops.get(body.getUUID()).map(loop -> loop.externalControlIdle()).orElse(false)) {
+            return JsonNull.INSTANCE;
+        }
+        var mobs = NearbyEntities.within(body, NearbyEntities.RADIUS, Mob.class, mob ->
+                mob instanceof Enemy && mob.isAlive() && !mob.isInvisibleTo(body)
+                        && !body.isAlliedTo(mob) && !mob.isAlliedTo(body)
+                        && (!(mob instanceof NeutralMob) || mob.getTarget() == body));
+        var nearest = mobs.stream().sorted(Comparator.<Mob>comparingDouble(body::distanceToSqr).thenComparingInt(Entity::getId))
+                .limit(MAX_SIGHT_CHECKS).toList();
+        var threats = new JsonArray();
+        for (var mob : nearest) {
+            // Bound the vanilla ray to loaded chunks, including across chunk borders.
+            if (!body.level().hasChunksAt(body.blockPosition(), mob.blockPosition()) || !body.hasLineOfSight(mob)) continue;
+            var threat = new JsonObject();
+            threat.addProperty("id", mob.getId());
+            threat.addProperty("uuid", mob.getUUID().toString());
+            threat.addProperty("type", BuiltInRegistries.ENTITY_TYPE.getKey(mob.getType()).toString());
+            threat.addProperty("reference", EntityLabel.of(mob));
+            threat.addProperty("health", mob.getHealth());
+            threat.addProperty("maxHealth", mob.getMaxHealth());
+            threat.addProperty("distance", Math.round(body.distanceTo(mob) * 10.0) / 10.0);
+            threat.addProperty("targetingSelf", mob.getTarget() == body);
+            threats.add(threat);
+            if (threats.size() == MAX_THREATS) break;
+        }
+        if (threats.isEmpty()) return JsonNull.INSTANCE;
+        var out = new JsonObject();
+        out.addProperty("sampledAt", System.currentTimeMillis());
+        out.addProperty("dimension", body.level().dimension().location().toString());
+        out.addProperty("selfId", body.getId());
+        out.addProperty("health", body.getHealth());
+        out.addProperty("maxHealth", body.getMaxHealth());
+        out.addProperty("food", body.getFoodData().getFoodLevel());
+        out.addProperty("heldItem", BuiltInRegistries.ITEM.getKey(body.getMainHandItem().getItem()).toString());
+        var position = new JsonArray();
+        position.add(body.getX());
+        position.add(body.getY());
+        position.add(body.getZ());
+        out.add("position", position);
+        out.add("threats", threats);
+        return out;
+    }
+}
