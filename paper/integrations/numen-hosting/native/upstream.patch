+package com.dwinovo.numen.api.entity;
+
+import com.dwinovo.numen.api.agent.inbox.EventTypes;
+import com.dwinovo.numen.api.brain.CompanionLoops;
+import com.dwinovo.numen.api.program.ServerPrograms;
+import com.dwinovo.numen.api.task.CompanionTickDispatcher;
+import com.dwinovo.numen.api.task.Task;
+import com.dwinovo.numen.api.task.TaskState;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.world.phys.EntityHitResult;
+import java.util.EnumSet;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+
+/** Game-thread machinery for a trusted hosting adapter, not an authorization
+ * endpoint. Bind only the website's verified UUID/owner/name. Existing bodies
+ * keep inventory, position, permissions and identity; no summon is performed. */
+public final class HostedBodyControls {
+    private static final Map<UUID, Seat> SEATS = new HashMap<>();
+    static { com.dwinovo.numen.api.platform.ServerLifecycle.onStopped(SEATS::clear); }
+    private HostedBodyControls() {}
+
+    public record Frame(long sequence, float yaw, float pitch, EnumSet<Controls.Key> keys,
+                        boolean attack, boolean use, int slot) {
+        public Frame {
+            if (sequence < 0 || !Float.isFinite(yaw) || Math.abs(yaw) > 36000
+                    || !Float.isFinite(pitch) || Math.abs(pitch) > 90 || keys == null || slot < 0 || slot > 8)
+                throw new IllegalArgumentException("invalid complete input frame");
+            keys = keys.clone();
+        }
+        @Override public EnumSet<Controls.Key> keys() { return keys.clone(); }
+    }
+    private static final class Seat implements Task {
+        final HostedControlLease lease = new HostedControlLease(15_000, 500);
+        Frame frame;
+        long applied = -1, attackTick = Long.MIN_VALUE, inputTickUntil;
+        String startedAt, lastProblem;
+        @Override public String name() { return "hosted input"; }
+        @Override public TaskState tick(NumenPlayer body) {
+            if (lease.releaseInput(System.currentTimeMillis()) || body.level().getGameTime()>=inputTickUntil || frame == null) {
+                release(body); return TaskState.RUNNING;
+            }
+            body.look().turn(frame.yaw(),frame.pitch());
+            for (Controls.Key key:Controls.Key.values()) body.controls().set(key,frame.keys.contains(key));
+            if (applied != frame.sequence()) { body.hotbar().hold(frame.slot()); applied=frame.sequence(); }
+            if (frame.attack()) {
+                if (body.mouse().pick() instanceof EntityHitResult hit) {
+                    body.mouse().release();
+                    long tick=body.level().getGameTime();
+                    if (tick!=attackTick && body.getAttackStrengthScale(0.5F)>=1.0F) {
+                        attackTick=tick;
+                        var result=body.mouse().attack(hit.getEntity());
+                        if (result instanceof Mouse.Blow.Refused refusal) problem(body,refusal.reason().toString());
+                    }
+                } else {
+                    var result=body.mouse().dig();
+                    if (result instanceof Mouse.Strike.Refused refusal) problem(body,refusal.reason().toString());
+                }
+            } else body.mouse().release();
+            if (frame.use()) {
+                var result=body.mouse().use();
+                if (result instanceof Mouse.Use.Refused refusal) problem(body,refusal.reason().toString());
+            } else body.mouse().stopUse();
+            return TaskState.RUNNING;
+        }
+        private void problem(NumenPlayer body,String reason) {
+            if (!reason.equals(lastProblem)) { lastProblem=reason;report(body,"Manual input refused: "+reason); }
+        }
+        @Override public void stop(NumenPlayer body,StopReason reason) { release(body); }
+        void release(NumenPlayer body) { body.controls().releaseAll();body.mouse().releaseAll(); }
+    }
+    public static boolean managed(MinecraftServer server,UUID uuid) {
+        var entry=CompanionRegistry.get(server).find(uuid);return entry!=null && entry.hosted();
+    }
+    /** A saved hosted body starts paused after a server restart. */
+    public static boolean driving(MinecraftServer server,UUID uuid,boolean ordinaryExternal) {
+        if (!managed(server,uuid)) return ordinaryExternal;
+        Seat seat=SEATS.get(uuid);return seat==null || seat.lease.holdsNativeLoop(System.currentTimeMillis());
+    }
+    public static HostedControlLease.State begin(NumenPlayer body,UUID expectedOwner,String expectedName,
+            HostedControlLease.Fence fence,HostedControlLease.Mode mode,String controller) {
+        MinecraftServer server=body.getServer();
+        if (server==null || server.getPlayerList().getPlayer(body.getUUID())!=body
+                || !expectedOwner.equals(body.getOwnerUuid()) || !expectedName.equals(body.getGameProfile().getName()))
+            throw new IllegalStateException("hosted body identity is not the registered live identity");
+        var registry=CompanionRegistry.get(server);var entry=registry.find(body.getUUID());
+        if (entry==null || !entry.owner().equals(expectedOwner) || !entry.name().equals(expectedName))
+            throw new IllegalStateException("hosted body registry identity differs");
+        Seat seat=SEATS.computeIfAbsent(body.getUUID(),ignored->new Seat());
+        seat.lease.begin(fence,mode,controller,System.currentTimeMillis());
+        registry.put(body.getUUID(),entry.withHosted());
+        if (seat.startedAt!=null) report(body,"Manual control ended: "+seat.startedAt+" -> "+location(body));
+        seat.startedAt=mode==HostedControlLease.Mode.MANUAL?location(body):null;
+        seat.frame=null;seat.applied=-1;seat.lastProblem=null;
+        fence(body,seat);
+        report(body,"Hosting requested "+mode.name().toLowerCase()+"; waiting for old actions to stop.");
+        return seat.lease.state();
+    }
+    public static HostedControlLease.State state(NumenPlayer body) {
+        Seat seat=SEATS.get(body.getUUID());return seat==null
+            ?new HostedControlLease.State(null,HostedControlLease.Mode.PAUSED,HostedControlLease.Mode.PAUSED,false,-1):seat.lease.state();
+    }
+    public static void heartbeat(NumenPlayer body,HostedControlLease.Fence fence) { seat(body).lease.heartbeat(fence,System.currentTimeMillis()); }
+    public static void input(NumenPlayer body,HostedControlLease.Fence fence,String controller,Frame frame) {
+        Seat seat=seat(body);seat.lease.input(fence,controller,frame.sequence(),System.currentTimeMillis());seat.frame=frame;
+        // Also bound simulated movement if the server runs accelerated ticks.
+        // Network loss must never hold a key beyond ten game ticks or 500 ms.
+        seat.inputTickUntil=body.level().getGameTime()+10;
+    }
+    public static void requireHarness(NumenPlayer body,HostedControlLease.Fence fence) { seat(body).lease.requireHarness(fence,System.currentTimeMillis()); }
+    private static Seat seat(NumenPlayer body) {
+        Seat seat=SEATS.get(body.getUUID());if (seat==null) throw new IllegalStateException("hosted body has no active control lease");return seat;
+    }
+    /** Runs before queued program callbacks and model ticks. */
+    public static void tick(MinecraftServer server) {
+        for (var player:server.getPlayerList().getPlayers()) {
+            if (!(player instanceof NumenPlayer body) || !managed(server,body.getUUID())) continue;
+            Seat seat=SEATS.computeIfAbsent(body.getUUID(),ignored->new Seat());long now=System.currentTimeMillis();
+            if (seat.lease.expire(now)) {
+                fence(body,seat);seat.frame=null;
+                report(body,"Hosting connection expired; controls paused, original actions are not replayed.");
+            }
+            var state=seat.lease.state();
+            // Native and harness tasks own their own keyboard. Clearing it here
+            // would silently suppress their movement on every server tick.
+            if ((!state.settled() || state.mode()==HostedControlLease.Mode.PAUSED
+                    || state.mode()==HostedControlLease.Mode.MANUAL) && (seat.lease.releaseInput(now)
+                    || body.level().getGameTime()>=seat.inputTickUntil)) seat.release(body);
+            if (state.fence()!=null && !state.settled() && !seat.lease.expired(now)
+                    && !ServerPrograms.running(body.getUUID()) && CompanionTickDispatcher.hostingIdle(body.getUUID())
+                    && CompanionLoops.get(body.getUUID()).map(loop->loop.externalControlIdle()).orElse(true))
+                seat.lease.confirmStopped(state.fence(),true,now);
+        }
+    }
+    public static Task task(NumenPlayer body) {
+        if (!managed(body.getServer(),body.getUUID())) return null;
+        Seat seat=SEATS.computeIfAbsent(body.getUUID(),ignored->new Seat());var state=seat.lease.state();
+        return !state.settled() || state.mode()==HostedControlLease.Mode.PAUSED || state.mode()==HostedControlLease.Mode.MANUAL?seat:null;
+    }
+    private static void fence(NumenPlayer body,Seat seat) {
+        CompanionLoops.get(body.getUUID()).ifPresent(loop->loop.holdForExternalControl());
+        ServerPrograms.stop(body);CompanionTickDispatcher.cancelFor(body);seat.release(body);
+    }
+    private static String location(NumenPlayer body) { return body.level().dimension().location()+" "+body.position()+" slot="+body.getInventory().selected; }
+    private static void report(NumenPlayer body,String text) { CompanionLoops.get(body.getUUID()).ifPresent(loop->loop.submitEvent(EventTypes.SERVER_MESSAGE,text)); }
+}
