+package com.dwinovo.numen.api.agent.http;
+import com.sun.net.httpserver.HttpServer;
+import com.google.gson.JsonObject;
+import org.junit.jupiter.api.Test;
+import java.net.InetSocketAddress;
+import java.nio.charset.StandardCharsets;
+import java.util.Map;
+import java.util.concurrent.CompletionException;
+import static org.junit.jupiter.api.Assertions.*;
+class TransportCredentialTest {
+    @Test void vendorErrorCannotEchoTheCredentialIntoLogsOrModelFailures() throws Exception {
+        String key="synthetic-secret-credential";
+        var server=HttpServer.create(new InetSocketAddress("127.0.0.1",0),0);
+        server.createContext("/",exchange->{byte[] bytes=("{\"error\":{\"message\":\"Rejected "+key+"\"}}").getBytes(StandardCharsets.UTF_8);exchange.sendResponseHeaders(401,bytes.length);try(var out=exchange.getResponseBody()){out.write(bytes);}});
+        server.start();try{
+            var transport=new HttpLlmTransport(null,Map.of(),Map.of("Authorization","Bearer "+key));
+            String url="http://127.0.0.1:"+server.getAddress().getPort()+"/";
+            for(boolean streaming:new boolean[]{false,true}){
+                var failure=assertThrows(CompletionException.class,()->{
+                    if(streaming)transport.postSse(url,"",new JsonObject(),ignored->{},new CancelToken()).join();
+                    else transport.post(url,"",new JsonObject()).join();
+                });
+                var http=assertInstanceOf(LlmHttpException.class,failure.getCause());
+                assertFalse(http.getMessage().contains(key));assertTrue(http.getMessage().contains("[REDACTED]"));
+            }
+        }finally{server.stop(0);}
+    }
+}
