+package com.dwinovo.numen.api.brain;
+
+import com.google.gson.JsonObject;
+import org.junit.jupiter.api.Test;
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+import java.nio.charset.StandardCharsets;
+import java.util.Base64;
+import static org.junit.jupiter.api.Assertions.*;
+
+class HostedModelsTest {
+    @Test void onlyAuthenticatedUnexpiredOperatorBindingsAreAccepted() throws Exception {
+        byte[] key = new byte[32]; java.util.Arrays.fill(key, (byte) 42);
+        var value = new JsonObject(); value.addProperty("expires", 30000);
+        String payload = Base64.getUrlEncoder().withoutPadding().encodeToString(value.toString().getBytes(StandardCharsets.UTF_8));
+        Mac mac = Mac.getInstance("HmacSHA256"); mac.init(new SecretKeySpec(key, "HmacSHA256"));
+        String signature = Base64.getUrlEncoder().withoutPadding().encodeToString(mac.doFinal(payload.getBytes(StandardCharsets.US_ASCII)));
+        assertEquals(30000, HostedModels.verify(key, payload, signature, 10000).get("expires").getAsLong());
+        assertThrows(Exception.class, () -> HostedModels.verify(new byte[32], payload, signature, 10000));
+        assertThrows(Exception.class, () -> HostedModels.verify(key, payload + "A", signature, 10000));
+        assertThrows(Exception.class, () -> HostedModels.verify(key, payload, signature, 30000));
+        assertThrows(Exception.class, () -> HostedModels.verify(key, payload, signature, -40000));
+    }
+}
