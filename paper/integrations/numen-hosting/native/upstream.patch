+package com.dwinovo.numen.api.entity;
+
+import com.google.gson.*;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import java.nio.file.Path;
+import java.util.UUID;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.AtomicInteger;
+import static org.junit.jupiter.api.Assertions.*;
+
+class HostedActionReceiptsTest {
+    @TempDir Path directory;
+    final UUID body=UUID.randomUUID();
+    JsonObject result(String id){return JsonParser.parseString("{\"id\":\""+id+"\",\"state\":\"completed\",\"message\":\"observed\"}").getAsJsonObject();}
+    @Test void lateCompletionAfterShutdownIsUnconfirmedAndRemainsUnknownOnDisk()throws Exception {
+        var accepted=new CountDownLatch(1);var action=new CompletableFuture<JsonObject>();
+        var journal=new HostedActionReceipts(directory);
+        var reply=journal.call(body,"request-stopping",new JsonObject(),()->{accepted.countDown();return action;});
+        assertTrue(accepted.await(5,TimeUnit.SECONDS));journal.close();
+        action.complete(result("request-stopping"));
+        assertThrows(ExecutionException.class,()->reply.get(5,TimeUnit.SECONDS));
+        try(var reopened=new HostedActionReceipts(directory)){
+            assertEquals("unknown",reopened.result(body,"request-stopping").get(5,TimeUnit.SECONDS).get("state").getAsString());
+        }
+    }
+    @Test void durableReceiptSurvivesRestartAndChangedArgumentsAreRejected()throws Exception {
+        var calls=new AtomicInteger();var args=JsonParser.parseString("{\"tool\":\"lua\",\"args\":{\"code\":\"observe\"}}").getAsJsonObject();
+        try(var journal=new HostedActionReceipts(directory)){
+            var first=journal.call(body,"request-one",args,()->{calls.incrementAndGet();return CompletableFuture.completedFuture(result("request-one"));}).get(5,TimeUnit.SECONDS);
+            assertEquals("completed",first.get("state").getAsString());
+        }
+        try(var journal=new HostedActionReceipts(directory)){
+            assertEquals("completed",journal.call(body,"request-one",args,()->{calls.incrementAndGet();return CompletableFuture.completedFuture(result("request-one"));}).get(5,TimeUnit.SECONDS).get("state").getAsString());
+            var changed=args.deepCopy();changed.addProperty("extra",true);
+            assertThrows(ExecutionException.class,()->journal.call(body,"request-one",changed,()->CompletableFuture.completedFuture(result("request-one"))).get(5,TimeUnit.SECONDS));
+        }assertEquals(1,calls.get());
+    }
+    @Test void originalUnknownActionNeverExecutesAgainOrAllowsANewAction()throws Exception {
+        var args=new JsonObject();var accepted=new CountDownLatch(1);var calls=new AtomicInteger();
+        try(var old=new HostedActionReceipts(directory)){
+            old.call(body,"request-unknown",args,()->{calls.incrementAndGet();accepted.countDown();return new CompletableFuture<>();});
+            assertTrue(accepted.await(5,TimeUnit.SECONDS));
+        }
+        try(var journal=new HostedActionReceipts(directory)){
+            assertEquals("unknown",journal.call(body,"request-unknown",args,()->{calls.incrementAndGet();return CompletableFuture.completedFuture(result("request-unknown"));}).get(5,TimeUnit.SECONDS).get("state").getAsString());
+            assertThrows(ExecutionException.class,()->journal.call(body,"request-new",args,()->CompletableFuture.completedFuture(result("request-new"))).get(5,TimeUnit.SECONDS));
+        }assertEquals(1,calls.get());
+    }
+}
