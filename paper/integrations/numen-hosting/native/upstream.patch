@@ -0,0 +1,117 @@
+package com.dwinovo.numen.api.entity;
+
+import java.util.Objects;
+
+/** One registered body's driving seat. The game thread owns all mutations.
+ * A mode change is pending until the actual task/program cancellation settles;
+ * no network acknowledgement alone is evidence that the old driver stopped. */
+public final class HostedControlLease {
+    public enum Mode { PAUSED, NUMEN, HARNESS, MANUAL }
+    public record Fence(String boot, long epoch) {
+        public Fence {
+            if (boot == null || boot.length() < 8 || boot.length() > 120 || epoch < 1)
+                throw new IllegalArgumentException("invalid controller generation");
+        }
+    }
+    public record State(Fence fence, Mode mode, Mode requested, boolean settled, long lastSequence) {}
+    private Fence fence;
+    private Mode mode = Mode.PAUSED;
+    private Mode requested = Mode.PAUSED;
+    private boolean settled;
+    private String controller;
+    private long heartbeatUntil;
+    private long inputUntil;
+    private long lastSequence = -1;
+    private final long heartbeatMillis;
+    private final long inputMillis;
+
+    public HostedControlLease(long heartbeatMillis, long inputMillis) {
+        if (inputMillis < 50 || heartbeatMillis < inputMillis || heartbeatMillis > 60_000)
+            throw new IllegalArgumentException("invalid hosting timeout");
+        this.heartbeatMillis = heartbeatMillis;
+        this.inputMillis = inputMillis;
+    }
+
+    /** Only the authenticated hosting service may install a new generation.
+     * A different process boot cannot replace a live controller. */
+    public void begin(Fence next, Mode target, String manualController, long now) {
+        Objects.requireNonNull(next);
+        Objects.requireNonNull(target);
+        if (fence != null) {
+            if (!fence.boot().equals(next.boot()) && now < heartbeatUntil)
+                throw new IllegalStateException("another hosting process still owns this body");
+            if (fence.boot().equals(next.boot()) && next.epoch() <= fence.epoch())
+                throw new IllegalStateException("controller generation must increase");
+        }
+        if (target == Mode.MANUAL && (manualController == null || manualController.isBlank()
+                || manualController.length() > 120))
+            throw new IllegalArgumentException("manual controller is required");
+        fence = next;
+        requested = target;
+        mode = Mode.PAUSED;
+        settled = false;
+        controller = manualController;
+        lastSequence = -1;
+        inputUntil = 0;
+        heartbeatUntil = now + heartbeatMillis;
+    }
+
+    /** Called only after checking real game queues, not a cached HTTP state. */
+    public void confirmStopped(Fence expected, boolean queuesEmpty, long now) {
+        requireFence(expected, now);
+        if (!queuesEmpty) return;
+        mode = requested;
+        settled = true;
+    }
+
+    public void heartbeat(Fence expected, long now) {
+        requireFence(expected, now);
+        heartbeatUntil = now + heartbeatMillis;
+    }
+
+    /** Validate before touching physical inputs. A rejected frame does not
+     * extend either deadline or change the last accepted sequence. */
+    public void input(Fence expected, String client, long sequence, long now) {
+        requireFence(expected, now);
+        if (!settled || mode != Mode.MANUAL || !Objects.equals(controller, client))
+            throw new IllegalStateException("manual control is not owned by this client");
+        if (sequence < 0 || sequence <= lastSequence)
+            throw new IllegalStateException("stale input sequence");
+        lastSequence = sequence;
+        inputUntil = now + inputMillis;
+        heartbeatUntil = now + heartbeatMillis;
+    }
+
+    public void requireHarness(Fence expected, long now) {
+        requireFence(expected, now);
+        if (!settled || mode != Mode.HARNESS)
+            throw new IllegalStateException("this body is not assigned to the harness");
+    }
+
+    /** True means the game must release all held keys/mouse this tick. */
+    public boolean releaseInput(long now) {
+        return !settled || mode != Mode.MANUAL || now >= inputUntil || now >= heartbeatUntil;
+    }
+
+    /** Service loss pauses both model modes as well as manual driving. The
+     * body remains in the world; recovery must reconcile its original tasks. */
+    public boolean expire(long now) {
+        if (fence == null || now < heartbeatUntil || (mode == Mode.PAUSED && !settled)) return false;
+        mode = Mode.PAUSED;
+        requested = Mode.PAUSED;
+        settled = false;
+        inputUntil = 0;
+        return true;
+    }
+
+    public boolean holdsNativeLoop(long now) {
+        return !settled || mode != Mode.NUMEN || now >= heartbeatUntil;
+    }
+    public State state() { return new State(fence, mode, requested, settled, lastSequence); }
+    public boolean expired(long now) { return fence==null || now>=heartbeatUntil; }
+
+    private void requireFence(Fence expected, long now) {
+        if (fence == null || !fence.equals(expected) || now >= heartbeatUntil)
+            throw new IllegalStateException("hosting lease expired or controller changed");
+    }
+}
