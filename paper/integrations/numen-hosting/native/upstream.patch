+    private static String string(JsonObject args,String key){if(!args.has(key)||!args.get(key).isJsonPrimitive()||!args.getAsJsonPrimitive(key).isString())throw new IllegalArgumentException("missing string: "+key);return args.get(key).getAsString();}
+    private NumenPlayer body(UUID uuid,JsonObject args){
