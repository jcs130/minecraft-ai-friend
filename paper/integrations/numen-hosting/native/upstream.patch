+package com.dwinovo.numen.api.brain;
+
+import com.dwinovo.numen.api.entity.HostedBodyControls;
+import com.dwinovo.numen.api.platform.ServerLifecycle;
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import net.minecraft.server.MinecraftServer;
+import java.util.*;
+
+/** Only spoken assistant replies, never thought deltas or tool arguments. */
+public final class HostedSpeech {
+    private static final Map<UUID,ArrayDeque<JsonObject>> SPEECH = new HashMap<>();
+    private static final String BOOT = UUID.randomUUID().toString();
+    private static long sequence;
+    static { ServerLifecycle.onStopped(SPEECH::clear); }
+    private HostedSpeech() {}
+    public static void said(MinecraftServer server,UUID companion,String text) {
+        if(!HostedBodyControls.managed(server,companion)||text==null||text.isBlank())return;
+        var row=new JsonObject();row.addProperty("id","speech-"+BOOT+"-"+(++sequence));row.addProperty("body",text.substring(0,Math.min(1200,text.length())));
+        row.addProperty("source","numen.hosted-speech");row.addProperty("createdAt",System.currentTimeMillis());
+        var queue=SPEECH.computeIfAbsent(companion,k->new ArrayDeque<>());queue.addLast(row);while(queue.size()>64)queue.removeFirst();
+    }
+    public static JsonArray read(UUID companion) {var rows=new JsonArray();for(var row:SPEECH.getOrDefault(companion,new ArrayDeque<>()))rows.add(row.deepCopy());return rows;}
+}
