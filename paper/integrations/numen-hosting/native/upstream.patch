+package com.dwinovo.numen.api.entity;
+
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class HostedControlLeaseTest {
+    private static final HostedControlLease.Fence FIRST = new HostedControlLease.Fence("process-one",1);
+    private static final HostedControlLease.Fence NEXT = new HostedControlLease.Fence("process-one",2);
+    private HostedControlLease lease() { return new HostedControlLease(15_000,500); }
+
+    @Test void aModeChangeWaitsForRealCancellation() {
+        var lease=lease();lease.begin(FIRST,HostedControlLease.Mode.HARNESS,null,100);
+        lease.confirmStopped(FIRST,false,101);
+        assertThrows(IllegalStateException.class,()->lease.requireHarness(FIRST,102));
+        assertTrue(lease.holdsNativeLoop(102));
+        lease.confirmStopped(FIRST,true,103);lease.requireHarness(FIRST,104);
+    }
+    @Test void takeoverRejectsOldModelCallsAndOtherBrowsers() {
+        var lease=lease();lease.begin(FIRST,HostedControlLease.Mode.HARNESS,null,100);
+        lease.confirmStopped(FIRST,true,101);lease.begin(NEXT,HostedControlLease.Mode.MANUAL,"browser-one",200);
+        lease.confirmStopped(NEXT,true,201);
+        assertThrows(IllegalStateException.class,()->lease.requireHarness(FIRST,202));
+        assertThrows(IllegalStateException.class,()->lease.input(NEXT,"browser-two",1,202));
+        lease.input(NEXT,"browser-one",1,202);assertFalse(lease.releaseInput(203));
+    }
+    @Test void oldFramesAndLateHeartbeatsCannotResurrectControl() {
+        var lease=lease();lease.begin(FIRST,HostedControlLease.Mode.MANUAL,"browser-one",100);
+        lease.confirmStopped(FIRST,true,101);lease.input(FIRST,"browser-one",2,102);
+        assertThrows(IllegalStateException.class,()->lease.input(FIRST,"browser-one",1,400));
+        assertTrue(lease.releaseInput(602));assertTrue(lease.expire(16000));
+        assertThrows(IllegalStateException.class,()->lease.heartbeat(FIRST,16001));
+        assertTrue(lease.holdsNativeLoop(16001));
+    }
+    @Test void aNewProcessCannotStealALiveBodyButCanRecoverAfterExpiry() {
+        var lease=lease();var other=new HostedControlLease.Fence("process-two",1);
+        lease.begin(FIRST,HostedControlLease.Mode.NUMEN,null,100);lease.confirmStopped(FIRST,true,101);
+        assertFalse(lease.holdsNativeLoop(102));
+        assertThrows(IllegalStateException.class,()->lease.begin(other,HostedControlLease.Mode.NUMEN,null,200));
+        lease.expire(16000);lease.begin(other,HostedControlLease.Mode.PAUSED,null,16001);
+        assertTrue(lease.holdsNativeLoop(16002));
+    }
+    @Test void sameOrOlderEpochCannotResetSequence() {
+        var lease=lease();lease.begin(NEXT,HostedControlLease.Mode.MANUAL,"browser-one",100);
+        assertThrows(IllegalStateException.class,()->lease.begin(FIRST,HostedControlLease.Mode.MANUAL,"browser-one",101));
+        assertThrows(IllegalStateException.class,()->lease.begin(NEXT,HostedControlLease.Mode.MANUAL,"browser-one",101));
+    }
+}
