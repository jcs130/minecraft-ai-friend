@@ -0,0 +1,99 @@
+package com.dwinovo.numen.api.brain;
+
+import com.dwinovo.numen.api.agent.llm.LlmEndpoint;
+import com.dwinovo.numen.api.agent.llm.NumenLlmClient;
+import com.dwinovo.numen.api.agent.llm.ProviderLibrary;
+import com.dwinovo.numen.api.entity.HostedBodyControls;
+import com.dwinovo.numen.api.entity.HostedControlLease;
+import com.dwinovo.numen.api.entity.NumenPlayer;
+import com.dwinovo.numen.api.home.Homes;
+import com.dwinovo.numen.api.platform.ServerLifecycle;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import net.minecraft.server.MinecraftServer;
+
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.security.MessageDigest;
+import java.util.Base64;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+
+/** A role's temporary model binding. Never writes vendor keys or changes the
+ * owner's ordinary provider library. Hosted bodies cannot use shared keys. */
+public final class HostedModels {
+    private record Binding(String id, LlmEndpoint endpoint, String problem) {}
+    private static final Map<UUID, Binding> BINDINGS = new java.util.concurrent.ConcurrentHashMap<>();
+    static { ServerLifecycle.onStopped(() -> { BINDINGS.values().forEach(b -> NumenLlmClient.release(b.endpoint())); BINDINGS.clear(); }); }
+    private HostedModels() {}
+
+    public static LlmEndpoint endpoint(UUID companion) {
+        Binding binding = BINDINGS.get(companion);
+        return binding == null ? LlmEndpoint.unresolved(null) : binding.endpoint();
+    }
+    public static String problem(UUID companion) { var binding=BINDINGS.get(companion); return binding==null?null:binding.problem(); }
+    public static void failed(UUID companion,LlmEndpoint endpoint,String code) {
+        BINDINGS.computeIfPresent(companion,(id,binding)->binding.endpoint()==endpoint?new Binding(binding.id(),binding.endpoint(),code):binding);
+    }
+
+    public static boolean configured(MinecraftServer server) {
+        try { return Files.size(Homes.of(server).server().file("hosted-model.key")) == 32; }
+        catch (Exception absent) { return false; }
+    }
+
+    /** Only a signed, short-lived operator request may bind a model. A scoped
+     * BRAIN token alone does not authorize selecting a server-side HTTP target. */
+    public static JsonObject change(MinecraftServer server, NumenPlayer body, String op, String payload, String signature) {
+        try {
+            byte[] key = Files.readAllBytes(Homes.of(server).server().file("hosted-model.key"));
+            JsonObject request = verify(key, payload, signature, System.currentTimeMillis());
+            if (!op.equals(request.get("op").getAsString())
+                    || !body.getUUID().toString().equals(request.get("roleUuid").getAsString())
+                    || !body.getOwnerUuid().toString().equals(request.get("ownerUuid").getAsString())
+                    || !body.getGameProfile().getName().equals(request.get("name").getAsString()))
+                throw new IllegalArgumentException();
+            var state = HostedBodyControls.state(body);
+            if (!state.settled() || state.mode() != HostedControlLease.Mode.PAUSED)
+                throw new IllegalStateException("pause and confirm old actions stopped before changing the hosted model");
+            String id = request.get("bindingId").getAsString();
+            if (!id.matches("[a-f0-9-]{36}")) throw new IllegalArgumentException();
+            Binding old = BINDINGS.get(body.getUUID());
+            if (op.equals("model_unbind")) {
+                if (old != null && !old.id().equals(id)) throw new IllegalStateException("another model binding is active");
+                if (old != null) { BINDINGS.remove(body.getUUID()); NumenLlmClient.release(old.endpoint()); }
+            } else {
+                if (old != null) throw new IllegalStateException("confirm the old model binding was revoked first");
+                var profile = ProviderLibrary.profileFromJson(request.getAsJsonObject("profile"))
+                        .withApiKey(request.get("apiKey").getAsString());
+                var endpoint = ModelServices.of(server).catalog().resolve(profile);
+                if (!endpoint.hasApiKey() || !endpoint.hasUrl()
+                        || !profile.model().equals(endpoint.model().id())) throw new IllegalArgumentException();
+                BINDINGS.put(body.getUUID(), new Binding(id, endpoint, null));
+                String goal = request.get("goal").getAsString();
+                if (goal.isBlank() || goal.length() > 4000) {
+                    BINDINGS.remove(body.getUUID()); throw new IllegalArgumentException();
+                }
+                CompanionBrains.ensure(server, body.getUUID()).submitPrompt("网站主人设置的托管目标：" + goal);
+            }
+            var result = new JsonObject(); result.addProperty("bindingId", id);
+            result.addProperty("isolatedByok", true); result.addProperty("stopped", op.equals("model_unbind"));
+            if (op.equals("model_bind")) result.addProperty("model", BINDINGS.get(body.getUUID()).endpoint().model().id());
+            return result;
+        } catch (IllegalStateException refused) { throw refused; }
+        catch (Exception refused) { throw new IllegalArgumentException("hosted model authorization or profile is invalid"); }
+    }
+
+    public static JsonObject verify(byte[] key, String payload, String signature, long now) throws Exception {
+        if (key.length != 32 || payload.length() > 32768) throw new IllegalArgumentException();
+        Mac mac = Mac.getInstance("HmacSHA256"); mac.init(new SecretKeySpec(key, "HmacSHA256"));
+        if (!MessageDigest.isEqual(mac.doFinal(payload.getBytes(StandardCharsets.US_ASCII)), Base64.getUrlDecoder().decode(signature)))
+            throw new IllegalArgumentException();
+        var value = JsonParser.parseString(new String(Base64.getUrlDecoder().decode(payload), StandardCharsets.UTF_8)).getAsJsonObject();
+        long expires = value.get("expires").getAsBigDecimal().longValueExact();
+        if (expires <= now || expires > now + 60000) throw new IllegalArgumentException();
+        return value;
+    }
+}
