+package com.dwinovo.numen.api.brain;
+
+import com.dwinovo.numen.api.entity.*;
+import com.dwinovo.numen.api.home.Homes;
+import com.dwinovo.numen.api.mcp.server.McpMode;
+import com.dwinovo.numen.api.platform.ServerLifecycle;
+import com.dwinovo.numen.mcp.server.McpToken;
+import com.dwinovo.numen.mcp.server.McpTokens;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.sun.net.httpserver.HttpServer;
+import net.minecraft.nbt.NbtAccounter;
+import net.minecraft.nbt.NbtIo;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.world.level.storage.LevelResource;
+
+import java.net.InetSocketAddress;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.*;
+import java.util.concurrent.*;
+
+/** Loopback provisioning for website-verified offline roles. All requests need
+ * the operator's HMAC; model tokens cannot provision bodies or mint tokens. */
+public final class HostedBootstrap {
+    private static HttpServer http;
+    private static ExecutorService executor;
+    private static final Map<UUID,McpTokens.Issued> TOKENS = new HashMap<>();
+    private static final Map<UUID,CompletableFuture<NumenPlayer>> ARRIVING = new HashMap<>();
+    static { ServerLifecycle.onStopped(() -> { if(http!=null)http.stop(0); if(executor!=null)executor.shutdownNow(); http=null;TOKENS.clear();ARRIVING.clear(); }); }
+    private HostedBootstrap() {}
+
+    public static void start(MinecraftServer server) {
+        if (!HostedModels.configured(server)) return;
+        try {
+            var settings=Homes.of(server).server().file("hosted-bootstrap.json");
+            if (!Files.exists(settings)) return;
+            var config=JsonParser.parseString(Files.readString(settings)).getAsJsonObject();
+            int port=config.get("port").getAsInt(),mcpPort=config.get("mcpPort").getAsInt();
+            if(port<1024||port>65535||mcpPort<1024||mcpPort>65535||port==mcpPort)throw new IllegalArgumentException();
+            var mode=McpMode.instance();
+            var current=mode.config();
+            if((!current.host().equals("127.0.0.1")||current.port()!=mcpPort||current.callTimeoutSeconds()!=300||!current.hiddenTools().isEmpty())
+                &&!mode.applySettings("127.0.0.1",mcpPort,300,List.of()))throw new IllegalStateException();
+            if(!mode.setEnabled(true))throw new IllegalStateException();
+            // Tokens issued by a prior hosting process are invalid after a boot.
+            var owners=new HashSet<UUID>();var registry=CompanionRegistry.get(server);
+            for(UUID id:registry.all())owners.add(registry.find(id).owner());
+            for(UUID owner:owners)for(var token:mode.tokens().ownedBy(owner))if(token.label().startsWith("website-hosted/"))mode.tokens().revoke(owner,token.id());
+            http=HttpServer.create(new InetSocketAddress("127.0.0.1",port),16);
+            executor=new ThreadPoolExecutor(2,2,0,TimeUnit.SECONDS,new ArrayBlockingQueue<>(32),r->{var t=new Thread(r,"hosted-bootstrap");t.setDaemon(true);return t;},new ThreadPoolExecutor.AbortPolicy());
+            http.setExecutor(executor);
+            http.createContext("/v1/hosted-role",exchange->{
+                JsonObject response=new JsonObject();int status=200;
+                try {
+                    if(!exchange.getRequestMethod().equals("POST")||!exchange.getRequestURI().toString().equals("/v1/hosted-role")
+                        ||!exchange.getRemoteAddress().getAddress().isLoopbackAddress()
+                        ||!("127.0.0.1:"+port).equals(exchange.getRequestHeaders().getFirst("Host"))
+                        ||exchange.getRequestHeaders().containsKey("Origin")||exchange.getRequestHeaders().containsKey("Cookie")
+                        ||exchange.getRequestHeaders().keySet().stream().anyMatch(k->k.equalsIgnoreCase("Forwarded")||k.toLowerCase(Locale.ROOT).startsWith("x-forwarded-")))throw new IllegalArgumentException();
+                    byte[] bytes=exchange.getRequestBody().readNBytes(49153);if(bytes.length>49152)throw new IllegalArgumentException();
+                    var envelope=JsonParser.parseString(new String(bytes,StandardCharsets.UTF_8)).getAsJsonObject();
+                    byte[] key=Files.readAllBytes(Homes.of(server).server().file("hosted-model.key"));
+                    var request=HostedModels.verify(key,envelope.get("payload").getAsString(),envelope.get("signature").getAsString(),System.currentTimeMillis());
+                    response=operate(server,request).get(45,TimeUnit.SECONDS);
+                }catch(Exception refused){status=409;response.addProperty("error","HOSTED_ROLE_NOT_READY");response.addProperty("message","角色未就绪：须由官网本人操作、角色离线且不属于旧版 Numen；请查询原角色状态，不要重复建号。");}
+                byte[] bytes=response.toString().getBytes(StandardCharsets.UTF_8);
+                exchange.getResponseHeaders().set("Content-Type","application/json; charset=utf-8");exchange.getResponseHeaders().set("Cache-Control","no-store");
+                exchange.sendResponseHeaders(status,bytes.length);try(var out=exchange.getResponseBody()){out.write(bytes);}
+            });
+            http.start();
+        }catch(Exception failed){throw new IllegalStateException("hosted bootstrap configuration could not be started");}
+    }
+
+    private static CompletableFuture<JsonObject> operate(MinecraftServer server,JsonObject request) {
+        var result=new CompletableFuture<JsonObject>();server.execute(()->{
+            try {
+                String op=request.get("op").getAsString(),name=request.get("name").getAsString();
+                UUID uuid=UUID.fromString(request.get("roleUuid").getAsString()),owner=UUID.fromString(request.get("ownerUuid").getAsString());
+                if(!name.matches("[A-Za-z0-9_]{1,16}")||uuid.equals(owner)||!Set.of("admit","session").contains(op))throw new IllegalArgumentException();
+                var registry=CompanionRegistry.get(server);var entry=registry.find(uuid);
+                if(entry!=null&&(!entry.hosted()||!entry.owner().equals(owner)||!entry.name().equals(name)))throw new IllegalStateException();
+                if(op.equals("session")) {
+                    if(entry==null)throw new IllegalStateException();
+                    var issued=TOKENS.computeIfAbsent(uuid,id->McpMode.instance().tokens().issue(owner,McpToken.Role.BRAIN,McpToken.Scope.of(Set.of(uuid)),"website-hosted/"+uuid,0));
+                    var reply=new JsonObject();reply.addProperty("token",issued.secret());reply.addProperty("endpoint",McpMode.instance().endpoint());reply.addProperty("roleUuid",uuid.toString());result.complete(reply);return;
+                }
+                var online=server.getPlayerList().getPlayer(uuid);var named=server.getPlayerList().getPlayerByName(name);
+                if(online!=null||named!=null) {
+                    if(!(online instanceof NumenPlayer body)||named!=online||!owner.equals(body.getOwnerUuid()))throw new IllegalStateException();
+                    var reply=new JsonObject();reply.addProperty("roleUuid",uuid.toString());reply.addProperty("name",name);reply.addProperty("ready",true);result.complete(reply);return;
+                }
+                for(UUID id:registry.all())if(!id.equals(uuid)&&registry.find(id).name().equalsIgnoreCase(name))throw new IllegalStateException();
+                CompletableFuture<NumenPlayer> pending=ARRIVING.get(uuid);
+                if(pending==null) {
+                    // Existing classic companions require a separate explicit migration.
+                    if(entry==null){
+                        var data=server.getWorldPath(LevelResource.PLAYER_DATA_DIR).resolve(uuid+".dat");
+                        if(Files.exists(data)){
+                            var tag=NbtIo.readCompressed(data,NbtAccounter.unlimitedHeap());
+                            if(tag.hasUUID("NumenOwner"))throw new IllegalStateException();
+                        }
+                        var level=server.overworld();registry.put(uuid,new CompanionRegistry.Entry(name,owner,level.dimension(),level.getSharedSpawnPos()).withHosted());
+                    }
+                    pending=new CompletableFuture<>();ARRIVING.put(uuid,pending);var arriving=pending;
+                    boolean started=Companions.respawn(server,uuid,arrival->{ARRIVING.remove(uuid);
