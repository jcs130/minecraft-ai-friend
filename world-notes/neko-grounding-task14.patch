+export function getBiomeName(bot) {
+    /**
+     * Get the name of the biome the bot is in.
+     * @param {Bot} bot - The bot to get the biome for.
+     * @returns {string} - The name of the biome.
+     * @example
+     * let biome = world.getBiomeName(bot);
+     **/
+    const biomeId = bot.world.getBiome(bot.entity.position);
+    // ★task#14b (天神 2026-09-19): same id-vs-index bug as prompter's $STATS lookup, and this one
+    // also fed decisions (migration / badBiome / full_state). mc.getAllBiomes() is an ARRAY in
+    // mcdata's own order, which does not match the networked biome id returned by getBiome();
+    // bot.registry.biomes IS keyed by the ids the server actually sent. Also guards the old
+    // "cannot read properties of undefined (reading 'name')" crash on an unmapped id.
+    const reg = bot.registry && bot.registry.biomes ? bot.registry.biomes[biomeId] : null;
+    if (reg && reg.name) return reg.name;
+    const fallback = mc.getAllBiomes()[biomeId];
+    return fallback && fallback.name ? fallback.name : 'unknown';
+}
