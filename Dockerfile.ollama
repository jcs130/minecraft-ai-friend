# ollama 镜像 + 内置 CPU embedding 模型（造物主决策 3：嵌入模型内置 docker，自包含部署）
#
# 构建时预拉取 bge-m3-cpu（566.7M 参数 / F16 / 1024 维），固化进镜像层，
# 部署到服务器后无需运行时联网 pull。
#
#   docker build -t mc-ollama -f Dockerfile.ollama .
FROM ollama/ollama:latest

# 可被 compose 覆盖：默认内置 bge-m3-cpu
ARG EMBED_MODEL=bge-m3-cpu:latest

# 起临时 ollama daemon -> 等就绪 -> pull 模型 -> 收尾
RUN ollama serve & \
    _srv=$!; \
    for _i in $(seq 1 60); do \
      curl -sf http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && break; \
      sleep 1; \
    done; \
    ollama pull "${EMBED_MODEL}"; \
    kill "$_srv" 2>/dev/null || true

EXPOSE 11434

ENTRYPOINT ["/bin/ollama"]
CMD ["serve"]
