{
  "schema": 1,
  "project": "qiandengji",
  "teamPurpose": "游戏世界运营组：统筹、运营、策划与体验检查；游戏会话角色独立运行",
  "inventoryCollector": {
    "taskName": "QiandengJi-Operations-Inventory",
    "kind": "windows-scheduled-task",
    "intervalSeconds": 120,
    "requiresLoggedInUser": true,
    "purpose": "定时采集公开状态，单次运行结束退出；不执行模型和启停",
    "queryCommand": "python tools/operations_inventory_task.py query"
  },
  "groups": {
    "game": [
      "mc",
      "world",
      "gate",
      "npc",
      "survivor"
    ],
    "dialogue": [
      "qwenpaw"
    ],
    "voice": [
      "tts",
      "voice",
      "asr",
      "resources"
    ],
    "management": [
      "panel",
      "control"
    ],
    "operations": [
      "qwenpaw-ops"
    ]
  },
  "services": [
    {
      "id": "survivor",
      "label": "桐人 · 自主生存",
      "group": "game",
      "purpose": "独立身体、自主规划与受控技能学习；控制台 18091",
      "dependencies": ["mc"],
      "healthRequired": true
    },
    {
      "id": "mc",
      "label": "Minecraft 世界",
      "group": "game",
      "purpose": "存档、模组与玩家进度",
      "dependencies": [],
      "healthRequired": true
    },
    {
      "id": "world",
      "label": "世界玩法",
      "group": "game",
      "purpose": "玩家命令、世界事件与女神会话接入",
      "dependencies": [
        "mc"
      ],
      "healthRequired": true
    },
    {
      "id": "gate",
      "label": "Agent 协议入口",
      "group": "game",
      "purpose": "复用现有 Agent 连接协议",
      "dependencies": [
        "mc"
      ],
      "healthRequired": false
    },
    {
      "id": "npc",
      "label": "村务服务",
      "group": "game",
      "purpose": "既有村民事件、任务与技能书消费",
      "dependencies": [
        "mc",
        "world"
      ],
      "healthRequired": true
    },
    {
      "id": "qwenpaw",
      "label": "游戏会话 QwenPaw",
      "group": "dialogue",
      "purpose": "天神、司礼的游戏会话；不等同于完整运营组",
      "dependencies": [],
      "healthRequired": true
    },
    {
      "id": "voice",
      "label": "语音回复队列",
      "group": "voice",
      "purpose": "将回复交给本项目 TTS 合成",
      "dependencies": [
        "tts"
      ],
      "healthRequired": true
    },
    {
      "id": "asr",
      "label": "咏唱语音识别",
      "group": "voice",
      "purpose": "本地录音识别与施法输入",
      "dependencies": [],
      "healthRequired": true
    },
    {
      "id": "resources",
      "label": "语音与模型资源",
      "group": "voice",
      "purpose": "本地资源包分发",
      "dependencies": [],
      "healthRequired": true
    },
    {
      "id": "panel",
      "label": "独立管理台",
      "group": "management",
      "purpose": "公开状态与运营组管理入口",
      "dependencies": [],
      "healthRequired": true
    },
    {
      "id": "tts",
      "label": "本项目语音合成",
      "group": "voice",
      "purpose": "D 盘独立 GPU 语音服务与女仆兼容接口",
      "dependencies": [],
      "healthRequired": true
    },
    {
      "id": "control",
      "label": "管理执行服务",
      "group": "management",
      "purpose": "受控启停、日志和操作回执；仅内网鉴权访问",
      "dependencies": [],
      "healthRequired": true
    },
    {
      "id": "qwenpaw-ops",
      "label": "世界运营组 QwenPaw",
      "group": "operations",
      "purpose": "六角色运营分析与提案；独立控制台 18090",
      "dependencies": [],
      "healthRequired": true
    }
  ],
