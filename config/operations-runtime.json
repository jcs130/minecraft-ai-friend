{
  "schema": 1,
  "project": "qiandengji",
  "teamPurpose": "游戏世界团队：10 个现有角色统一在游戏 QwenPaw 18089；旧运营实例归档保留",
  "inventoryCollector": {
    "container": "qiandengji-inventory-1",
    "kind": "docker-compose-service",
    "intervalSeconds": 120,
    "requiresLoggedInUser": false,
    "purpose": "容器内定时采集公开状态；仅查询，不执行模型和启停",
    "queryCommand": "docker compose ps inventory"
  },
  "groups": {
    "game": [
      "mc",
      "world",
      "gate",
      "npc",
      "survivor"
    ],
    "dialogue": [
      "qwenpaw"
    ],
    "voice": [
      "tts",
      "voice",
      "asr",
      "resources"
    ],
    "management": [
      "panel",
      "control",
      "inventory"
    ],
    "operations": ["qwenpaw"]
  },
  "services": [
    {
      "id": "survivor",
      "label": "桐人 · 自主生存",
      "group": "game",
      "purpose": "桐人的世界感知、自主调度和技能执行；角色统一在游戏控制台 18089",
      "dependencies": ["mc", "qwenpaw"],
      "healthRequired": true
    },
    {
      "id": "mc",
      "label": "Minecraft 世界",
      "group": "game",
      "purpose": "存档、模组与玩家进度",
      "dependencies": [],
      "healthRequired": true
    },
    {
      "id": "world",
      "label": "世界玩法",
      "group": "game",
      "purpose": "玩家命令、世界事件与女神会话接入",
      "dependencies": [
        "mc"
      ],
      "healthRequired": true
    },
    {
      "id": "gate",
      "label": "Agent 协议入口",
      "group": "game",
      "purpose": "复用现有 Agent 连接协议",
      "dependencies": [
        "mc"
      ],
      "healthRequired": false
    },
    {
      "id": "npc",
      "label": "村务服务",
      "group": "game",
      "purpose": "既有村民事件、任务与技能书消费",
      "dependencies": [
        "mc",
        "world"
      ],
      "healthRequired": true
    },
    {
      "id": "qwenpaw",
      "label": "游戏世界团队 QwenPaw",
      "group": "dialogue",
      "purpose": "女神、天神、司灯、策划、桐人与结衣等 10 个现有角色的会话、技能与原生任务",
      "dependencies": [],
      "healthRequired": true
    },
    {
      "id": "voice",
      "label": "语音回复队列",
      "group": "voice",
      "purpose": "将回复交给本项目 TTS 合成",
      "dependencies": [
        "tts"
      ],
      "healthRequired": true
    },
    {
      "id": "asr",
      "label": "咏唱语音识别",
      "group": "voice",
      "purpose": "本地录音识别与施法输入",
      "dependencies": [],
      "healthRequired": true
    },
    {
      "id": "resources",
      "label": "语音与模型资源",
      "group": "voice",
      "purpose": "本地资源包分发",
      "dependencies": [],
      "healthRequired": true
    },
    {
      "id": "panel",
      "label": "独立管理台",
      "group": "management",
      "purpose": "公开状态与运营组管理入口",
      "dependencies": [],
      "healthRequired": true
    },
    {
      "id": "tts",
      "label": "本项目语音合成",
      "group": "voice",
      "purpose": "D 盘独立 GPU 语音服务与女仆兼容接口",
      "dependencies": [],
      "healthRequired": true
    },
    {
      "id": "control",
      "label": "管理执行服务",
      "group": "management",
      "purpose": "受控启停、日志和操作回执；仅内网鉴权访问",
      "dependencies": [],
      "healthRequired": true
    },
    {
      "id": "inventory",
      "label": "状态采集",
      "group": "management",
      "purpose": "每两分钟更新本游戏世界的服务和角色状态，Docker 守护，不运行模型",
      "dependencies": [],
      "healthRequired": true
    },
    {
      "id": "qwenpaw-ops",
      "label": "旧运营 QwenPaw（已归档）",
      "group": "operations",
      "purpose": "原角色已合并到游戏 18089；保留历史数据，禁止自动启动重复团队",
      "active": false,
      "dependencies": [],
      "healthRequired": true
    }
  ],
  "externalServices": [
    {
      "id": "shared-tts",
      "label": "语音合成接口",
      "group": "dependency",
      "container": "qiandengji-tts-1",
      "purpose": "D 项目 TTS 的兼容接口 8100",
      "managedBy": "D 项目 Compose",
      "dependencies": [],
      "required": true,
      "healthUrl": "http://127.0.0.1:8100/health"
    },
    {
      "id": "legacy-qwenpaw",
      "label": "原游戏运营组 QwenPaw",
      "group": "legacy-team",
      "container": "shadow-qwenpaw",
      "purpose": "原司灯、运营、策划及体验角色；单独显示配置与驱动状态",
      "managedBy": "旧 shadow Compose",
      "dependencies": [],
      "required": false,
      "desiredState": "exited",
      "desiredRestart": "no"
    },
    {
      "id": "legacy-opsdrive",
      "label": "原运营轮巡驱动",
      "group": "legacy-team",
      "container": "shadow-opsdrive",
      "purpose": "旧团队主动运营驱动，退出状态不表示 Agent 配置被删除",
      "managedBy": "旧 shadow Compose",
      "dependencies": [
        "legacy-qwenpaw"
      ],
      "required": false,
      "desiredState": "exited",
      "desiredRestart": "no"
    },
    {
      "id": "legacy-guard",
      "label": "原体验角色驱动",
      "group": "legacy-team",
      "container": "shadow-guard",
      "purpose": "原角色巡游驱动，当前状态单独核对",
      "managedBy": "旧 shadow Compose",
      "dependencies": [
        "legacy-qwenpaw"
      ],
      "required": false,
      "desiredState": "exited",
      "desiredRestart": "no"
    },
    {
      "id": "retired-gate",
      "label": "已退役的旧协议入口",
      "group": "retired",
      "container": "shadow-gate",
      "purpose": "旧 MC 已停且无连接；停用记录保留，重新启动会提示",
      "managedBy": "退役清单 · 保留容器与回退方式",
      "dependencies": [],
      "required": false,
      "desiredState": "exited",
      "desiredRestart": "no"
    },
    {
      "id": "retired-voice",
      "label": "已退役的旧语音队列",
      "group": "retired",
      "container": "shadow-voice",
      "purpose": "旧输入队列为空；历史合成输出保留，D 使用独立队列",
