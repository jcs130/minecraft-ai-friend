# minecraft_companion MCP 镜像（造物主决策 4：minecraft MCP 有用，容器内 agent 靠它操作 MC 角色）
#
# 源项目 = mindcraft-autoplayer（node src/server.js，监听 4177，/mcp 暴露 MCP）
# 描述即 "Minecraft AI Friend — MC Server / Mindcraft / AI villagers / village plan"。
# 依赖极轻（仅 prismarine-schematic），其余 Node 内置自实现（MCP server / data-store / vector-memory）。
#
# build context = mindcraft-autoplayer 项目根目录（compose 里指定）
#   docker build -t mc-autoplayer -f Dockerfile.autoplayer <autoplayer_dir>
FROM node:22-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install --omit=dev --no-audit --no-fund \
    --registry=https://registry.npmmirror.com

COPY src ./src
COPY public ./public

# data/ 由 volume bind mount（ai-friend.sqlite / autopilot-memory.json / config.json / village-state.json / community-blueprints）
EXPOSE 4177

ENV MINDCRAFT_AUTOPLAYER_PORT=4177

CMD ["node", "src/server.js"]
